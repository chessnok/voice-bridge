# Скопируй в .env и заполни. Обязателен только OPENAI_API_KEY.
OPENAI_API_KEY=sk-...

# Langfuse-трейсинг (опционально): без ключей просто выключен
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Удалённый бэкенд (опционально): клиент ходит на сервер вместо локального агента
#VB_AGENT_URL=http://my-server:8765
#VB_AGENT_TOKEN=придумай-длинный-токен

# Тонкая настройка (значения по умолчанию разумные)
#VB_HOTKEY=ctrl+k
#VB_REALTIME_MODEL=gpt-realtime-2
#VB_REALTIME_VOICE=marin
#VB_VAD_EAGERNESS=auto
#VB_MINI_MODEL=gpt-5.1
#VB_MINI_WORKDIR=~/Ассистент
#VB_AGENT_BROWSER_BIN=agent-browser
